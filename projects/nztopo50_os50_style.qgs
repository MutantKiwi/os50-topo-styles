     <placement allowDegraded="0" centroidInside="0" centroidWhole="0" dist="0" distMapUnitScale="3x:0,0,0,0,0,0" distUnits="Point" fitInPolygonOnly="0" geometryGenerator="with_variable('segs', geometries_to_array(segments_to_lines($geometry)),&#10;with_variable('scores',&#10;  array_foreach(&#10;    generate_series(1, array_length(@segs) - 2),&#10;    with_variable('i', @element,&#10;      degrees(acos(cos(&#10;        azimuth(start_point(array_get(@segs, @i - 1)), end_point(array_get(@segs, @i - 1)))&#10;        - azimuth(start_point(array_get(@segs, @i)), end_point(array_get(@segs, @i)))&#10;      )))&#10;      +&#10;      degrees(acos(cos(&#10;        azimuth(start_point(array_get(@segs, @i)), end_point(array_get(@segs, @i)))&#10;        - azimuth(start_point(array_get(@segs, @i + 1)), end_point(array_get(@segs, @i + 1)))&#10;      )))&#10;    )&#10;  ),&#10;with_variable('joins',&#10;  array_filter(&#10;    generate_series(1, array_length(@segs) - 2),&#10;    array_get(@scores, @element - 1) &gt;= 100&#10;    AND cos(&#10;      azimuth(start_point(array_get(@segs, @element)), end_point(array_get(@segs, @element)))&#10;      - azimuth(start_point(array_get(@segs, 0)), end_point(array_get(@segs, 0)))&#10;    ) &lt; 0&#10;  ),&#10;  CASE&#10;    WHEN array_length(@joins) &gt; 0 THEN&#10;      with_variable('starts', array_foreach(@joins, line_locate_point($geometry, start_point(array_get(@segs, @element)))),&#10;      with_variable('ends', array_foreach(@joins, line_locate_point($geometry, end_point(array_get(@segs, @element)))),&#10;      with_variable('froms', array_cat(array(0), @ends),&#10;      with_variable('tos', array_cat(@starts, array(length($geometry))),&#10;        collect_geometries(&#10;          array_foreach(&#10;            generate_series(0, array_length(@froms) - 1),&#10;            line_substring($geometry, array_get(@froms, @element), array_get(@tos, @element))&#10;          )&#10;        )&#10;      ))))&#10;    ELSE $geometry&#10;  END&#10;)))" geometryGeneratorEnabled="1" geometryGeneratorType="LineGeometry" labelOffsetMapUnitScale="3x:0,0,0,0,0,0" layerType="LineGeometry" lineAnchorClipping="1" lineAnchorPercent="0.5" lineAnchorTextPoint="CenterOfText" lineAnchorType="1" maxCurvedCharAngleIn="25" maxCurvedCharAngleOut="-25" maximumDistance="0" maximumDistanceMapUnitScale="3x:0,0,0,0,0,0" maximumDistanceUnit="MM" multipartBehavior="SplitLabelTextLinesOverParts" offsetType="0" offsetUnits="MM" overlapHandling="AllowOverlapIfRequired" overrunDistance="50" overrunDistanceMapUnitScale="3x:0,0,0,0,0,0" overrunDistanceUnit="MM" placement="3" placementFlags="10" polygonPlacementFlags="2" predefinedPositionOrder="TR,TL,BR,BL,R,L,TSR,BSR" preserveRotation="1" prioritization="PreferCloser" priority="10" quadOffset="4" repeatDistance="0" repeatDistanceMapUnitScale="3x:0,0,0,0,0,0" repeatDistanceUnits="MM" rotationAngle="0" rotationUnit="AngleDegrees" whitespaceCollisions="IgnoreWhitespaceCollisions" xOffset="0" yOffset="0" />
